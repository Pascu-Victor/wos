# Append to configs/wos-services.conf only in a disposable validation VM.

[service resource-policy]
user=root
group=root
supplementary-groups=none
umask=0022
authority-ceiling=65535
no-new-privileges=no
service-privileges=none
exec=/usr/bin/testprog
arg=/usr/bin/testprog
arg=resource-limits
arg=service-policy
depends=journald
type=oneshot
class=normal
priority=0
environment=init
readiness=exit-success
readiness-timeout-ms=5000
restart=never
backoff-initial-ms=10
backoff-max-ms=10
restart-budget=16
restart-window-ms=60000
stable-run-ms=60000
stop-term-ms=1000
stop-kill-ms=1000
drain-timeout-ms=1000
stdio=journal
enable=always
limit-cpu=3:4
limit-fsize=4:4
limit-stack=524288:524288
limit-core=0:0
limit-nproc=64:64
limit-nofile=8:8
limit-as=134217728:134217728

[service resource-nproc-zero]
user=root
group=root
supplementary-groups=none
umask=0022
authority-ceiling=65535
no-new-privileges=no
service-privileges=none
exec=/usr/bin/testprog
arg=/usr/bin/testprog
arg=resource-limits
arg=nproc-exec
depends=journald
type=oneshot
class=normal
priority=0
environment=init
readiness=exit-success
readiness-timeout-ms=5000
restart=never
backoff-initial-ms=10
backoff-max-ms=10
restart-budget=16
restart-window-ms=60000
stable-run-ms=60000
stop-term-ms=1000
stop-kill-ms=1000
drain-timeout-ms=1000
stdio=journal
enable=always
limit-nproc=0:0

[service resource-as-denied]
user=root
group=root
supplementary-groups=none
umask=0022
authority-ceiling=65535
no-new-privileges=no
service-privileges=none
exec=/usr/bin/testprog
arg=/usr/bin/testprog
arg=resource-limits
arg=service-policy
depends=journald
type=oneshot
class=normal
priority=0
environment=init
readiness=exit-success
readiness-timeout-ms=5000
restart=never
backoff-initial-ms=10
backoff-max-ms=10
restart-budget=16
restart-window-ms=60000
stable-run-ms=60000
stop-term-ms=1000
stop-kill-ms=1000
drain-timeout-ms=1000
stdio=journal
enable=always
limit-as=0:infinity

[service resource-cpu-restart]
user=root
group=root
supplementary-groups=none
umask=0022
authority-ceiling=65535
no-new-privileges=no
service-privileges=none
exec=/usr/bin/testprog
arg=/usr/bin/testprog
arg=resource-limits
arg=service-cpu-restart
depends=journald
type=daemon
class=normal
priority=0
environment=init
readiness=immediate
readiness-timeout-ms=5000
restart=on-failure
backoff-initial-ms=10
backoff-max-ms=10
restart-budget=16
restart-window-ms=60000
stable-run-ms=60000
stop-term-ms=1000
stop-kill-ms=1000
drain-timeout-ms=1000
stdio=journal
enable=always
limit-cpu=2:2
limit-core=0:0
