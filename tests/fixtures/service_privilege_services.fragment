# Disposable VM only; install root:root 06755 /usr/bin/identity-setid-probe first.

[service journal-grant-policy]
user=httpd
group=httpd
supplementary-groups=none
umask=0077
authority-ceiling=16384
no-new-privileges=yes
service-privileges=journal-read
exec=/usr/bin/identity-setid-probe
arg=/usr/bin/identity-setid-probe
arg=credentials
arg=delegation-service-check
arg=1
depends=journald
depends=dropbear-keygen
type=oneshot
class=normal
priority=0
environment=empty
readiness=exit-success
readiness-timeout-ms=5000
restart=never
backoff-initial-ms=250
backoff-max-ms=30000
restart-budget=5
restart-window-ms=60000
stable-run-ms=60000
stop-term-ms=2000
stop-kill-ms=1000
drain-timeout-ms=2000
stdio=journal
enable=always

[service network-grant-policy]
user=httpd
group=httpd
supplementary-groups=none
umask=0077
authority-ceiling=4096
no-new-privileges=yes
service-privileges=network-admin
exec=/usr/bin/testprog
arg=/usr/bin/testprog
arg=credentials
arg=delegation-service-check
arg=2
depends=journald
depends=dropbear-keygen
type=oneshot
class=normal
priority=0
environment=empty
readiness=exit-success
readiness-timeout-ms=5000
restart=never
backoff-initial-ms=250
backoff-max-ms=30000
restart-budget=5
restart-window-ms=60000
stable-run-ms=60000
stop-term-ms=2000
stop-kill-ms=1000
drain-timeout-ms=2000
stdio=journal
enable=always
