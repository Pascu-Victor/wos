# Append only in a disposable validation VM. Install a root:root 06755 copy of
# testprog at /usr/bin/identity-setid-probe to verify NNP during init exec.

[service identity-policy]
user=httpd
group=httpd
supplementary-groups=none
umask=0077
authority-ceiling=0
no-new-privileges=yes
service-privileges=none
exec=/usr/bin/testprog
arg=/usr/bin/testprog
arg=credentials
arg=service-policy
depends=journald
depends=dropbear-keygen
type=oneshot
class=normal
priority=0
environment=empty
readiness=exit-success
readiness-timeout-ms=5000
restart=never
backoff-initial-ms=250
backoff-max-ms=30000
restart-budget=5
restart-window-ms=60000
stable-run-ms=60000
stop-term-ms=2000
stop-kill-ms=1000
drain-timeout-ms=2000
stdio=journal
enable=always

[service identity-setid-policy]
user=httpd
group=httpd
supplementary-groups=none
umask=0077
authority-ceiling=0
no-new-privileges=yes
service-privileges=none
exec=/usr/bin/identity-setid-probe
arg=/usr/bin/identity-setid-probe
arg=credentials
arg=service-policy
depends=journald
depends=dropbear-keygen
type=oneshot
class=normal
priority=0
environment=empty
readiness=exit-success
readiness-timeout-ms=5000
restart=never
backoff-initial-ms=250
backoff-max-ms=30000
restart-budget=5
restart-window-ms=60000
stable-run-ms=60000
stop-term-ms=2000
stop-kill-ms=1000
drain-timeout-ms=2000
stdio=journal
enable=always
