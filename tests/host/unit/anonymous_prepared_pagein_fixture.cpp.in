    ++model::reclaim_calls;
    return model::allocate(model::topology.memory[0].base);
}
auto page_alloc_order0_span_in_range_may_fail(PhysicalPageOwner, uint64_t first, uint64_t, uint32_t pages, uint64_t, PageInitialization)
    -> void* {
    model::check(pages == 1, "one page factory");
    return model::allocate(first);
}
auto page_ref_dec(void* p) -> uint32_t {
    model::check(!model::cow && !model::pin && !model::queue, "ref return after locks");
    for (auto& b : model::blocks)
        if (b.p == p) {
            model::check(b.refs > 0, "exact ref return");
            --b.refs;
            ++model::releases;
            return b.refs;
        }
    std::abort();
}
}  // namespace ker::mod::mm::phys
