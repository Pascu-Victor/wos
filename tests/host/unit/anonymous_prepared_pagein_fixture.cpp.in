namespace task {
enum class TaskState { ACTIVE, EXITING, DEAD };
enum class TaskType { DAEMON, PROCESS };
// Explicit continuation-admission endpoint, not a scheduler implementation.
enum class WaitChannelKind { GENERIC, WKI_EXECVE_PROXY };
struct Thread { ~Thread() { ++model::thread_deletes; } };
struct Task {
    static constexpr uint32_t ACTIVE_REGISTRY_INDEX_INVALID=UINT32_MAX;
    mm::paging::PageTable* pagemap{};
    Task* anonymous_swap_wait_next{};
    void* anonymous_swap_wait_mapping{};
    uint64_t anonymous_swap_wait_generation{};
    std::atomic<uint64_t> anonymous_swap_completion_generation{};
    std::atomic<uint32_t> ref_count{1};
    std::atomic<uint32_t>& refs=ref_count; // One count; alias preserves old25 oracles.
    std::atomic<TaskState> state{TaskState::ACTIVE};
    TaskType type{TaskType::DAEMON};
    std::atomic<bool> scheduler_published{},gc_queued{},wakeup_pending{};
    int heap_index{-1};enum class Queue { NONE, WAITING, RUNNABLE };Queue sched_queue{Queue::NONE};
    Task* sched_next{};std::atomic<void*>sched_list_owner{};
    uint32_t active_registry_index{ACTIVE_REGISTRY_INDEX_INVALID};
    std::atomic<uint32_t> usercopy_pagemap_accesses{};
    std::atomic<bool> usercopy_pagemap_closing{},scheduler_transition_active{},exit_in_progress{};
    uint64_t syscall_account_start_us{}; bool has_exited{};
    bool deferred_task_switch{}, wants_block{}, voluntary{}, interrupting_signal{}, wki_execve{};
    uint32_t wki_proxy_task_id{};
    auto is_voluntary_blocked() const -> bool { return voluntary; }
    auto wait_channel_is(WaitChannelKind kind) const -> bool { return kind==WaitChannelKind::WKI_EXECVE_PROXY && wki_execve; }
    auto has_interrupting_signal_pending() -> bool { return interrupting_signal; }
    auto memory_policy_snapshot() const noexcept -> mm::numa::Policy { return policy; }
    auto try_acquire_usercopy_pagemap(mm::paging::PageTable*& out) -> bool;
    void release_usercopy_pagemap();
    std::atomic<Task*> owned_unpublished_process{};
    std::atomic<void*> native_file_mapping_retirement{};
    void (*kthread_entry)(){};
    ShutdownOwnership kernel_shutdown_ownership;
    mm::numa::Policy policy{};
    Thread* thread{};char* name{};
    struct Context {uintptr_t syscall_scratch_area{};uint64_t syscall_kernel_stack{};}context;
    bool has_lazy{},has_fds{};
    ACTUAL_TRY_ACQUIRE
    void release() { ref_count.fetch_sub(1,std::memory_order_acq_rel); }
    static auto create_kernel_thread(const char*,void(*)())->Task*;
    ~Task(){if(thread||name){model::check(!has_lazy&&!has_fds,"real full destructor returned lazy/FD owners");++model::destroyed;}}
};
