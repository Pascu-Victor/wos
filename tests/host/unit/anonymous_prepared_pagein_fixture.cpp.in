namespace ker::mod::mm::swap {
struct SwapSlot {
    uint32_t area{1};
    uint64_t index{3}, generation{1};
};
struct SlotIo {
    SwapSlot slot{};
    void* page{};
    void* device{};
    bool active{};
};
auto free_slot(SwapSlot) -> int {
    model::check(!model::cow && !model::pin, "slot free after locks");
    if(model::free_hook){auto h=std::move(model::free_hook);h();}model::checkpoint();++model::slot_frees;return 0;
}
auto allocate_slot(SwapSlot*out)->int {if(model::slot_hook){auto h=std::move(model::slot_hook);h();}model::checkpoint();*out={};return 0;}
auto write_slot(SwapSlot,const void*)->int {auto const HOLD=ker::mod::sched::hold_kernel_shutdown();if(model::write_hook){auto h=std::move(model::write_hook);h();}model::checkpoint();return model::io_error;}
struct SwapStats{uint64_t free_bytes{4096};};void get_stats(SwapStats*out){*out={};}
auto swap_available()->bool{return true;}
auto submit_slot_io(SlotIo& io, SwapSlot s, void* p, bool write) -> int {
    model::check(!model::cow && !model::pin && !write, "read outside locks");
    if(model::preparation_scopes)model::check(model::current_usercopy_accesses()==0 && model::gates==1 && model::preempt==0,"I/O owns only real operation root gate");
    io.slot = s;
    io.page = p;
    io.active = true;
    ++model::reads;
    return 0;
}
auto finish_slot_io(SlotIo& io) -> int {
    io.active = false;
    if (!model::io_error) std::memset(io.page, 0x3c, 4096);
    return model::io_error;
}
}  // namespace ker::mod::mm::swap
