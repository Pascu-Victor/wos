void wake_task_from_event(task::Task*t){model::check(!model::cow&&!model::queue&&!model::pin,"canonical wake outside metadata locks");++model::wakes;t->wakeup_pending=true;model::waiting=false;if(model::wake_hook){auto h=std::move(model::wake_hook);h();}}
// Actual wait loop calls this finite PROCESS continuation endpoint. It proves
// caller ownership is absent; real rescheduling/lost-wake behavior is not modeled.
void preemptible_syscall_park(const char* reason, task::WaitChannelKind kind) {
    model::check(std::strcmp(reason,"anon_swap")==0 && kind==task::WaitChannelKind::GENERIC,"exact continuation park request");
    model::check(current && current->type==task::TaskType::PROCESS && model::interrupts && !model::preempt &&
                     !model::cow && !model::pin && !model::queue && model::current_usercopy_accesses()==0,
                 "park outside all caller leases and metadata owners");
    model::check(++model::parks<8,"finite supplied park progress");
    if(model::park_hook){auto h=std::move(model::park_hook);h();}
}
void kern_yield(){++model::yields;model::check(model::yields<20,"bounded migrate progress");if(model::yield_hook){auto h=std::move(model::yield_hook);h();}model::checkpoint();}
auto hold_kernel_shutdown()->KernelShutdownHold{return KernelShutdownHold(current?&current->kernel_shutdown_ownership:nullptr);}
[[noreturn]]void exit_current_kernel_thread(){model::check(current&&!current->kernel_shutdown_ownership.held(),"all worker drain holds released before exit");current->state=task::TaskState::DEAD;throw model::WorkerExit{};}
void kern_block(){++model::block_calls;model::checkpoint();auto*t=current;model::check(t!=nullptr,"real modeled worker identity");model::waiting=true;
 if(model::block_hook){auto h=std::move(model::block_hook);h();}
 if(t->wakeup_pending.exchange(false)){model::waiting=false;return;}throw model::WorkerPark{};}
auto post_task_for_cpu(uint64_t cpu,task::Task*t)->bool{model::check(cpu==0&&t==current,"exact CPU0 post subject");++model::posts;
 model::check(t->refs==2&&t->kernel_shutdown_ownership.held(),"private boot ref and shutdown hold before post");
 if(model::post_hook){auto h=std::move(model::post_hook);h();}
 if(model::post_result){t->scheduler_published=true;return true;}
 if(model::corrupt_failed_post)t->scheduler_published=true;return false;}
auto get_active_task_count()->uint32_t{return 1;}
auto get_active_task_at_safe(uint32_t)->task::Task*;
}
namespace model {unsigned current_usercopy_accesses(){auto*t=ker::mod::sched::current;return t?t->usercopy_pagemap_accesses.load():0;}}
// Privileged IF/current/process admission is a finite Host port. Actual Scope
// target bodies and genuine scheduled entrance are separate qualification.
namespace ker::mod::sys {
class SyscallPreparationScope {
 public:
  explicit SyscallPreparationScope(sched::task::Task&t):incoming_(model::interrupts){
   ready_=sched::current==&t&&t.type==sched::task::TaskType::PROCESS&&t.syscall_account_start_us!=0&&
     t.state.load()==sched::task::TaskState::ACTIVE&&!t.scheduler_transition_active&&model::preempt==0;
   if(ready_)model::interrupts=true; ++model::preparation_scopes;
  }
  ~SyscallPreparationScope(){model::interrupts=incoming_;--model::preparation_scopes;}
  auto ready()const->bool{return ready_;}
 private:bool incoming_{},ready_{};
};
}
