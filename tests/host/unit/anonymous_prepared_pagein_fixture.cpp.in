namespace model {
unsigned checks{}, cases{}, allocations{}, reclaim_calls{}, releases{}, reads{}, slot_frees{}, wakes{}, yields{}, captures{};
unsigned cow{}, pin{}, queue{}, gates{}, preempt{}, noio{}, last_alloc_noio{};
unsigned preparation_scopes{}, parks{}; bool interrupts{true}, missing_leaf{}, runqueues{true};
unsigned current_usercopy_accesses();
bool fail_alloc{}, fail_gate{}, fail_capture{}, published{true};
bool shutdown{}, enabled{true}, fail_create{}, post_result{true}, corrupt_failed_post{}, waiting{};
unsigned created{}, destroyed{}, thread_deletes{}, stack_frees{}, lazy_returns{}, fd_returns{}, posts{}, block_calls{}, deferred_exit_checks{};
std::function<void()> post_hook, block_hook, slot_hook, write_hook, free_hook, yield_hook, park_hook, wake_hook;
struct WorkerExit {}; struct WorkerPark {}; struct Panic {}; struct AutomaticExit {};
void checkpoint();
int io_error{};
uint64_t serial{7}, ticks{}, cpu{};
std::function<void()> allocation_hook;
ker::mod::acpi::numa::Topology topology{};
struct Block {
    void* p{};
    uint64_t physical{};
    unsigned refs{};
};
std::vector<Block> blocks;
void check(bool v, const char* what) {
    ++checks;
    if (!v) {
        std::fprintf(stderr, "FAIL %s case=%u\n", what, cases);
        std::abort();
    }
}
unsigned live() {
    unsigned n = 0;
    for (auto& b : blocks) n += b.refs;
    return n;
}
struct Lock {
    unsigned* depth;
    uint64_t lock_irqsave() {
        check(*depth == 0, "nonrecursive lock");
        ++*depth;
        return 0;
    }
    void unlock_irqrestore(uint64_t) {
        check(*depth == 1, "held lock");
        --*depth;
    }
};
void* allocate(uint64_t physical) {
    check(cow == 0 && pin == 0 && queue == 0, "allocation outside metadata locks");
    if (preparation_scopes) check(current_usercopy_accesses()==0 && gates==0 && preempt==0,"ordinary allocation before caller owners");
    ++allocations;
    last_alloc_noio = noio;
    if (allocation_hook) {
        auto h = std::move(allocation_hook);
        h();
    }
    if (fail_alloc) return nullptr;
    void* p = std::aligned_alloc(4096, 4096);
    check(p != nullptr, "Host page");
    std::memset(p, 0xa5, 4096);
    blocks.push_back({p, physical + blocks.size() * 4096, 1});
    return p;
}
void domains(unsigned n) {
    topology = {};
    topology.node_count = n;
    topology.cpu_count = n;
    topology.memory_range_count = n;
    for (unsigned i = 0; i < n; ++i) {
        topology.cpu_nodes[i] = i;
        topology.nodes[i].usable_bytes = 0x100000;
        topology.memory[i] = {0x10000000ULL + i * 0x100000ULL, 0x100000, static_cast<uint16_t>(i), 0};
        for (unsigned j = 0; j < n; ++j) topology.distances[i][j] = i == j ? 10 : 20;
    }
}
