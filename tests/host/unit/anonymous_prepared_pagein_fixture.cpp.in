namespace fixture {
namespace v = ker::mod::mm::virt;
namespace n = ker::mod::mm::numa;
namespace p = ker::mod::mm::paging;
namespace s = ker::mod::sched;
constexpr uint64_t VA = 0x400000;
p::PageTable roots[2]{};
s::task::Task actor{};
auto context(n::Mode mode = n::Mode::LOCAL, n::NodeMask mask = 0, n::NodeId local = 0) -> n::AllocationContext {
    return {{mask, mode}, local, VA / 4096};
}
void reset(unsigned nodes = 2) {
    model::check(v::anonymous_swap_mappings == nullptr && model::live() == 0 && model::gates == 0, "case closure");
    for (auto& b : model::blocks) std::free(b.p);
    model::blocks.clear();
    model::domains(nodes);
    model::cow = model::pin = model::queue = 0;
    model::fail_alloc = model::fail_gate = model::fail_capture = false;
    model::published = true;
    model::io_error = 0;
    model::serial = 7;
    model::allocation_hook = {};
    model::allocations = model::reclaim_calls = model::reads = model::slot_frees = model::yields = model::captures = 0;
    v::anonymous_pagein_queue_count = v::anonymous_pagein_queue_head = v::anonymous_pagein_queue_tail = 0;
    v::anonymous_pagein_queue.fill(nullptr);
    v::anonymous_swap_stats.swapped_pages = 0;
    v::anonymous_swap_stats.pagein_inflight = 0;
    actor.pagemap = &roots[0];
    actor.policy = {};
    actor.anonymous_swap_wait_mapping = nullptr;
    actor.anonymous_swap_wait_next = nullptr;
    actor.refs = 1;
    v::entries[&roots[0]] = v::pte_from_raw(p::PAGE_USER | p::PAGE_RESERVED);
    v::entries[&roots[1]] = v::pte_from_raw(p::PAGE_USER | p::PAGE_RESERVED);
    model::shutdown=false;model::cpu=0;
    v::anonymous_swap_service_closed=false;v::anonymous_swap_admission=true;
    static s::task::Task ready_worker;
    ready_worker.state=s::task::TaskState::ACTIVE;ready_worker.ref_count=2;
    v::anonymous_swap_worker_task=&ready_worker;
    ++model::cases;
}
auto row() -> v::AnonymousSwapMapping* {
    auto* r = new v::AnonymousSwapMapping{};
    r->pagemap = &roots[0];
    r->vaddr = VA;
    r->generation = 3;
    r->state = v::AnonymousSwapRuntimeState::SWAPPED;
    r->object = new v::AnonymousSwapObject{};
    r->object->mapping_refs = 1;
    r->original_raw = p::PAGE_USER | p::PAGE_WRITE;
    r->maintenance_placement = context();
    r->maintenance_valid = true;
    v::insert_anonymous_swap_mapping_locked(r);
    ++v::anonymous_swap_stats.swapped_pages;
    return r;
}
auto snapshot(v::AnonymousSwapMapping* r) -> v::AnonymousPageinSnapshot {
    return {reinterpret_cast<uint64_t>(r->pagemap), model::serial, r->generation, r->vaddr};
}
auto fault(bool user = true) -> v::AnonymousSwapFaultDisposition {
    uint64_t gen = 0;
    return v::probe_anonymous_swap_fault(&actor, VA, p::PageFault{}, user, gen);
}
void process(bool cancelled = false) {
    auto* r = v::anonymous_pagein_dequeue();
    model::check(r != nullptr, "actual queued row");
    r->cancelled = cancelled;
    v::AnonymousPageinOperation op;
    v::begin_anonymous_pagein(r, op);
    v::finish_anonymous_pagein(op);
}
void close_installed() {
    for (auto& b : model::blocks) {
        if (!b.refs) continue;
        auto const& entry = v::entries[&roots[0]];
        model::check(entry.present && (static_cast<uint64_t>(entry.frame) << 12) == b.physical, "installed exact owned physical frame");
        for (unsigned i = 0; i < 4096; ++i) model::check(static_cast<unsigned char*>(b.p)[i] == 0x3c, "restored full stored bytes");
        ker::mod::mm::phys::page_ref_dec(b.p);
    }
}
void purge() {
    v::purge_anonymous_swap_mappings(&roots[0]);
    v::purge_anonymous_swap_mappings(&roots[1]);
}
void check_failed_backing(v::AnonymousSwapMapping* r, int e) {
    model::check(r->state == v::AnonymousSwapRuntimeState::FAILED && r->error == e && r->object && r->object->mapping_refs == 1,
                 "terminal failure retains stored ref");
    model::check(
        model::slot_frees == 0 && v::anonymous_swap_stats.swapped_pages == 0 && !r->pagein_queued && model::gates == 0 && actor.refs == 1,
        "exact pending debt drain");
}
void run() {
    reset();
    auto* r = row();
    model::check(!v::legacy_anonymous_worker(context()), "NUMA default prepares");
    model::check(fault() == v::AnonymousSwapFaultDisposition::PARK, "NUMA prepared parks");
    model::check(model::allocations == 1 && r->frame && model::live() == 1, "candidate owned in row");
    process();
    model::check(model::reads == 1 && model::slot_frees == 1 && actor.refs == 1 && model::gates == 0, "success drains");
    close_installed();
    reset(1);
    r = row();
    model::check(v::legacy_anonymous_worker(context()), "UMA local keeps worker");
    model::check(fault() == v::AnonymousSwapFaultDisposition::PARK && model::allocations == 0 && r->frame == nullptr,
                 "legacy publish allocates none");
    model::cpu = 0;
    process();
    model::check(model::allocations == 1 && model::reclaim_calls == 1 && model::reads == 1, "real factory legacy reclaim dispatch");
    close_installed();
    reset(1);
    r = row();
    actor.policy = {1, n::Mode::BIND};
    model::check(fault() == v::AnonymousSwapFaultDisposition::PARK && model::allocations == 1 && model::reclaim_calls == 0,
                 "UMA explicit BIND prepared");
    process();
    close_installed();
    reset();
    r = row();
    model::fail_alloc = true;
    model::check(fault() == v::AnonymousSwapFaultDisposition::FAILED, "prequeue ENOMEM current fault");
    model::check(r->state == v::AnonymousSwapRuntimeState::SWAPPED && r->object && r->error == 0 && !r->pagein_queued && model::gates == 0,
                 "no mutation on capacity refusal");
    model::fail_alloc = false;
    model::check(fault() == v::AnonymousSwapFaultDisposition::PARK, "retry after refusal");
    process();
    close_installed();
    reset();
    r = row();
    v::anonymous_pagein_queue_count = 256;
    model::check(fault() == v::AnonymousSwapFaultDisposition::FAILED && model::live() == 0 && model::gates == 0,
                 "queue refusal returns candidate");
    model::check(r->frame == nullptr && r->object && r->error == 0, "queue rollback retains slot");
    v::anonymous_pagein_queue_count = 0;
    purge();
    reset();
    r = row();
    model::fail_gate = true;
    model::check(fault() == v::AnonymousSwapFaultDisposition::FAILED && model::live() == 0, "gate refusal returns candidate");
    model::fail_gate = false;
    purge();
    reset();
    r = row();
    model::allocation_hook = [] { ++model::serial; };
    model::check(fault() == v::AnonymousSwapFaultDisposition::FAILED && model::live() == 0 && !r->pagein_queued,
                 "root serial race rejects candidate");
    purge();
    reset();
    r = row();
    model::allocation_hook = [r] { ++r->generation; };
    model::check(fault() == v::AnonymousSwapFaultDisposition::FAILED && model::live() == 0, "row generation race rejects");
    purge();
    reset();
    r = row();
    model::check(fault(false) == v::AnonymousSwapFaultDisposition::FAILED && model::allocations == 0 && !r->pagein_queued,
                 "new CPL0 boundary");
    purge();
    reset();
    r = row();
    model::check(fault() == v::AnonymousSwapFaultDisposition::PARK, "first waiter");
    s::task::Task second;
    second.pagemap = &roots[0];
    uint64_t gen = 0;
    model::check(v::probe_anonymous_swap_fault(&second, VA, p::PageFault{}, true, gen) == v::AnonymousSwapFaultDisposition::PARK &&
                     model::allocations == 1 && model::captures == 1,
                 "duplicate joins winner without allocation/context");
    process();
    model::check(second.refs == 1 && second.anonymous_swap_wait_mapping == nullptr, "duplicate ref released");
    close_installed();
    reset();
    r = row();
    model::check(fault() == v::AnonymousSwapFaultDisposition::PARK, "cancel preparation");
    process(true);
    model::check(model::live() == 0 && model::reads == 0 && model::slot_frees == 1 && actor.refs == 1 && model::gates == 0,
                 "cancel before begin returns exact prepared frame");
    reset(1);
    r = row();
    model::check(fault() == v::AnonymousSwapFaultDisposition::PARK, "legacy OOM job");
    model::fail_alloc = true;
    process();
    check_failed_backing(r, -ENOMEM);
    model::check(v::migrate_anonymous_swap_area(nullptr, 1) == -ENOMEM && model::yields == 0, "migration returns retained FAILED errno");
    model::check(v::clone_anonymous_swap_mappings(&roots[0], &roots[1]) && r->object->mapping_refs == 2,
                 "retained FAILED clone shares charged object");
    v::purge_anonymous_swap_mappings(&roots[0]);
    model::check(model::slot_frees == 0, "first teardown retains slot");
    v::purge_anonymous_swap_mappings(&roots[1]);
    model::check(model::slot_frees == 1, "last clone frees slot");
    reset();
    r = row();
    auto snap = snapshot(r);
    model::fail_alloc = true;
    auto c = v::service_anonymous_pagein(snap, context());
    model::check(c.status == -ENOMEM && !c.retry && !c.retired && !r->pagein_queued && r->state == v::AnonymousSwapRuntimeState::SWAPPED &&
                     r->object && r->error == 0 && model::gates == 0,
                 "sync ENOMEM unjoinable and retryable");
    model::fail_alloc = false;
    c = v::service_anonymous_pagein(snap, context());
    model::check(c.status == 0 && !c.retired && !c.retry && model::reads == 1, "sync exact own completion");
    close_installed();
    reset();
    r = row();
    snap = snapshot(r);
    auto invalid = context();
    invalid.policy.mode = static_cast<n::Mode>(255);
    c = v::service_anonymous_pagein(snap, invalid);
    model::check(c.status == -EINVAL && model::allocations == 0 && r->object, "invalid context no effects");
    purge();
    reset();
    r = row();
    snap = snapshot(r);
    model::allocation_hook = [r] { ++r->generation; };
    c = v::service_anonymous_pagein(snap, context());
    model::check(c.status == -EAGAIN && c.retry && model::live() == 0 && !r->pagein_queued, "sync raced candidate exact retry");
    purge();
    for (int error : {-EIO, -EILSEQ, -ENOMEM}) {
        reset();
        r = row();
        model::io_error = error;
        model::check(fault() == v::AnonymousSwapFaultDisposition::PARK, "IO failure job");
        process();
        model::check(r->state == v::AnonymousSwapRuntimeState::FAILED && r->error == error && !r->object && model::slot_frees == 1 &&
                         model::live() == 0,
                     "completed IO failure old detach semantics");
        purge();
    }
    reset();
    r = row();
    r->pagein_allocation = v::AnonymousPageinAllocation::PREPARED;
    r->pagein_placement_valid = true;
    r->pagein_placement = context();
    r->pagein_queued = true;
    r->pagein_access_gate = ++model::gates;
    v::AnonymousPageinOperation op;
    v::begin_anonymous_pagein(r, op);
    v::finish_anonymous_pagein(op);
    check_failed_backing(r, -EIO);
    model::check(model::allocations == 0, "missing prepared never worker fallback");
    purge();
    reset();
    r = row();
    actor.policy = {2, n::Mode::BIND};
    model::check(fault() == v::AnonymousSwapFaultDisposition::PARK, "copied BIND winner");
    actor.policy = {1, n::Mode::BIND};
    model::cpu = 0;
    process();
    model::check(model::blocks.back().physical == model::topology.memory[1].base, "worker cannot recapture foreign policy/CPU");
    close_installed();
    reset();
    r = row();
    model::allocation_hook = [] { purge(); };
    model::check(fault() == v::AnonymousSwapFaultDisposition::NOT_TRACKED && model::live() == 0 && model::slot_frees == 1,
                 "removed row returns candidate without escaped pointer");
    reset();
    r = row();
    snap = snapshot(r);
    model::allocation_hook = [] { purge(); };
    c = v::service_anonymous_pagein(snap, context());
    model::check(c.status == -ECANCELED && c.retired && !c.retry && model::live() == 0, "sync removed row exact retired result");
    reset(1);
    r = row();
    model::check(fault() == v::AnonymousSwapFaultDisposition::PARK, "legacy noio later batch");
    {
        ker::mod::mm::reclaim::NoIoScope scope;
        process();
    }
    model::check(model::reclaim_calls == 1 && model::noio == 0 && model::last_alloc_noio == 1,
                 "legacy NoIo nesting preserved at factory seam");
    close_installed();
    reset();
    r = row();
    model::check(fault() == v::AnonymousSwapFaultDisposition::PARK, "cancel after begin job");
    auto* issued = v::anonymous_pagein_dequeue();
    v::AnonymousPageinOperation cancelled;
    v::begin_anonymous_pagein(issued, cancelled);
    model::check(cancelled.should_read, "real issued IO before cancellation");
    issued->cancelled = true;
    c = v::finish_anonymous_pagein(cancelled);
    model::check(
        c.retired && c.status == -ECANCELED && model::live() == 0 && model::slot_frees == 1 && actor.refs == 1 && model::gates == 0,
        "cancelled in-flight page exact frame/slot/waiter/gate return");
    reset();
    model::check(model::live() == 0 && model::preempt == 0 && model::gates == 0, "final closure");
    std::printf("PASS actual anonymous pagein cases=%u checks=%u\n", model::cases, model::checks);
}
