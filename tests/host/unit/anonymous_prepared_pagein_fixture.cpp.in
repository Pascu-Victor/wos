void page_ref_inc(void*p){for(auto&b:model::blocks)if(b.p==p){model::check(b.refs>0,"pin real modeled frame");++b.refs;return;}std::abort();}
auto page_alloc_may_fail(PhysicalPageOwner, uint64_t, std::string_view) -> void* { return model::allocate(model::topology.memory[0].base); }
auto page_alloc_full_overwrite_page_may_fail(PhysicalPageOwner, std::string_view) -> void* {
    return model::allocate(model::topology.memory[0].base);
}
auto page_alloc_with_reclaim_may_fail(PhysicalPageOwner, uint64_t, std::string_view, uint32_t) -> void* {
    ++model::reclaim_calls;
    return model::allocate(model::topology.memory[0].base);
}
