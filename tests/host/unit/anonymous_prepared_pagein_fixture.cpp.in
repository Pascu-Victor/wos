struct Entries {std::map<std::pair<PageTable*,uint64_t>,PageTableEntry> table;
 auto at(PageTable*r,uint64_t va)->PageTableEntry&{return table[{r,va}];}
 auto operator[](PageTable*r)->PageTableEntry&{return at(r,0x400000);}}entries;
auto page_align_down(uint64_t v) -> uint64_t { return v & ~4095ULL; }
auto pte_from_raw(uint64_t r) -> PageTableEntry {
    PageTableEntry e;
    static_assert(sizeof(e) == sizeof(r));
    std::memcpy(&e, &r, 8);
    return e;
}
auto is_reserved_leaf(const PageTableEntry& e) -> bool { return e.present == 0; }
auto leaf_entry(PageTable* r, vaddr_t va) -> PageTableEntry* {
    model::check(model::cow == 1, "PTE under COW");
    return model::missing_leaf?nullptr:&entries.at(r,va);
}
auto capture_user_root_incarnation(PageTable*, uint64_t& out) -> bool {
    model::check(model::cow == 1, "root registry via COW");
    out = model::serial;
    return out != 0;
}
auto acquire_user_pagemap_access(PageTable*, bool, size_t& out) -> bool {
    model::check(model::cow == 1 || model::current_usercopy_accesses()!=0, "operation gate under COW or short caller Task lease");
    if (model::fail_gate) return false;
    out = ++model::gates;
    return true;
}
void release_user_pagemap_access(size_t g) {
    if (g != USER_PAGEMAP_ACCESS_GATE_NONE) {
        model::check(model::gates > 0, "gate owned");
        --model::gates;
    }
}
auto pte_raw(const PageTableEntry&e)->uint64_t{uint64_t raw;std::memcpy(&raw,&e,8);return raw;}
void owned_frame_untrack_leaf(PageTable*,uint64_t,const PageTableEntry&){}
void owned_frame_track_fresh_normal_mapping(PageTable*, vaddr_t, uint64_t, uint64_t) {
    model::check(model::cow && model::pin, "tracked install locking");
}
void flush_pagemap_after_update(PageTable*, vaddr_t, bool) { model::check(!model::cow && !model::pin, "flush outside metadata locks"); }
void anonymous_swap_add(std::atomic<uint64_t>& v, uint64_t n = 1) { v.fetch_add(n); }
void anonymous_swap_update_max(std::atomic<uint64_t>& v, uint64_t n) { v.store(std::max(v.load(), n)); }
auto capture_demand_context(sched::task::Task* t, uint64_t va, DemandOrigin, bool, DemandContext& out) -> bool {
    model::check(!model::cow && !model::pin && !model::queue && t->anonymous_swap_wait_mapping == nullptr, "actor capture before new caller leases");
    ++model::captures;
    if (model::fail_capture) return false;
    if (numa::capture_allocation_context(t->policy, out.allocation) != numa::AllocationError::NONE) return false;
    out.allocation.virtual_page_index = va / 4096;
    return true;
}
