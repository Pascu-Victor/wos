diff --git a/src/doomgeneric.c b/src/doomgeneric.c
index 7f275d5..a70cbba 100644
--- a/src/doomgeneric.c
+++ b/src/doomgeneric.c
@@ -22,20 +22,59 @@
 
 #include <stdlib.h>
 
+#if defined(__WOS__)
+#include <sys/ioctl.h>
+#include <unistd.h>
+#endif
+
 unsigned DOOMGENERIC_RESX = 80;
 unsigned DOOMGENERIC_RESY = 50;
 
 uint32_t *DG_ScreenBuffer = 0;
 
+#if defined(__WOS__)
+static int wos_default_scaling(void)
+{
+	struct winsize terminal = { 0 };
+	if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &terminal) < 0
+		|| terminal.ws_col == 0 || terminal.ws_row < 2)
+		return 10;
+
+	/*
+	 * ASCII pixels are two terminal columns wide. Keep one row free so
+	 * the final newline cannot scroll and tear the frame.
+	 */
+	const unsigned usable_rows = terminal.ws_row - 1U;
+	const unsigned width_scale =
+		(SCREENWIDTH * 2U + terminal.ws_col - 1U) / terminal.ws_col;
+	const unsigned height_scale =
+		(SCREENHEIGHT + usable_rows - 1U) / usable_rows;
+	unsigned scaling = width_scale > height_scale ? width_scale : height_scale;
+
+	/* Match upstream's performance-conscious default on large terminals. */
+	if (scaling < 4U)
+		scaling = 4U;
+
+	return (int)scaling;
+}
+#endif
+
 void dg_Create()
 {
 	int i;
 	i = M_CheckParmWithArgs("-scaling", 1);
 	if (i > 0) {
 		i = atoi(myargv[i + 1]);
-		DOOMGENERIC_RESX = SCREENWIDTH / i;
-		DOOMGENERIC_RESY = SCREENHEIGHT / i;
 	}
+#if defined(__WOS__)
+	else
+		i = wos_default_scaling();
+#endif
+
+	if (i > 0) {
+		DOOMGENERIC_RESX = SCREENWIDTH / (unsigned)i;
+		DOOMGENERIC_RESY = SCREENHEIGHT / (unsigned)i;
+	}
 
 	DG_ScreenBuffer = malloc((unsigned long)DOOMGENERIC_RESX * DOOMGENERIC_RESY * 4);
 
