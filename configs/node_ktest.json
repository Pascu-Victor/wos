{
    "build": {
        "dir": "build-ktest",
        "state_root": "ktest-data",
        "sysroot": "ktest-data/sysroot",
        "mlibc_build": "ktest-data/mlibc-build",
        "mlibc_conformance_stage": "ktest-data/mlibc-conformance-stage",
        "libcxx_build": "ktest-data/libcxx-build",
        "busybox_build": "ktest-data/busybox-build",
        "busybox_install": "ktest-data/busybox-install",
        "dropbear_build": "ktest-data/dropbear-build",
        "make_build": "ktest-data/make-build",
        "bash_build": "ktest-data/bash-build",
        "zlib_build": "ktest-data/zlib-build",
        "openssl_build": "ktest-data/openssl-build",
        "curl_build": "ktest-data/curl-build",
        "git_build": "ktest-data/git-build",
        "clang_build": "ktest-data/clang-wos-build",
        "ninja_build": "ktest-data/ninja-build",
        "cmake_host_build": "ktest-data/cmake-host-build",
        "cmake_host_install": "ktest-data/host",
        "cmake_build": "ktest-data/cmake-wos-build",
        "python_build": "ktest-data/python-build",
        "meson_build": "ktest-data/meson-build",
        "nasm_build": "ktest-data/nasm-build",
        "ncurses_build": "ktest-data/ncurses-build",
        "nano_build": "ktest-data/nano-build",
        "doom_ascii_build": "ktest-data/doom-ascii-build",
        "tools_output": "ktest-data/tools/bin"
    },
    "package": {
        "kernel_cmdline": "--selftest"
    },
    "node": {
        "id": 0,
        "hostname": "wos-ktest",
        "debug": false,
        "mtu": 9000,
        "vm": {
            "memory": "32G",
            "cpus": 32,
            "disk0": "ktest-data/disk.qcow2",
            "disk1": "ktest-data/mountfs.qcow2",
            "overlay_dir": "ktest-data/overlays",
            "serial_log": "ktest-data/serial-vm0.log",
            "qemu_log": "ktest-data/qemu-vm0.log",
            "tcg_log": "ktest-data/qemu-vm0-cpu%d.log",
            "usb_hotplug": {
                "enabled": true,
                "controller_id": "xhci",
                "usb2_ports": 4,
                "usb3_ports": 4,
                "qmp_socket": "ktest-data/qmp-vm0.sock"
            }
        },
        "nics": [
            {
                "name": "lan",
                "zone_id": 0,
                "tap": "wos-lan-KT",
                "mac": "52:54:00:10:00:00",
                "model": "virtio-net-pci",
                "queues": 2,
                "vhost": false,
                "driver": "dhcp",
                "bridge": {
                    "stp": false,
                    "ip": "10.10.0.100/24",
                    "dns": "10.10.0.1"
                }
            },
            {
                "name": "wki",
                "zone_id": 1,
                "tap": "wos-wki-KT",
                "mac": "52:54:00:11:00:00",
                "model": "virtio-net-pci",
                "queues": 8,
                "vhost": true,
                "driver": "wki",
                "bridge": {
                    "stp": false,
                    "ip": null
                }
            }
        ]
    }
}
